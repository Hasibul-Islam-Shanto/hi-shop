# App
NODE_ENV=development
SERVER_PORT=5000
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# Database (Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/hi_shop

# JWT
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-chars-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=20m
REFRESH_TOKEN_EXPIRES_IN=7d

# Mail (optional — used by MailService)
EMAIL_USER=
EMAIL_PASS=
